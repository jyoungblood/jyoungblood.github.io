---
import { getCollection } from 'astro:content';

import RepositoryLayout from '../layouts/RepositoryLayout.astro';

const repositories = await getCollection('repositories');
const repositoryOwners = new Set(repositories.map(({ data }) => data.owner));

const featuredRepositories = repositories
  .filter(({ data }) => data.featured)
  .sort((a, b) => a.data.order - b.data.order);

const repositoryIndex = [...repositories].sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  if (a.data.archived !== b.data.archived) return a.data.archived ? 1 : -1;
  if (a.data.fork !== b.data.fork) return a.data.fork ? 1 : -1;
  return a.data.title.localeCompare(b.data.title, 'en', { sensitivity: 'base' });
});

const formatRepositoryDate = (date: string) =>
  new Intl.DateTimeFormat('en-US', {
    month: 'short',
    year: 'numeric',
  }).format(new Date(date));
---

<RepositoryLayout
  title="Jonathan Youngblood — Open Source Projects"
  description="Open source projects by Jonathan Youngblood and VergeKit."
>

