    <section id="repository-index" aria-labelledby="repository-index-heading">
      <table>
        <thead>
          <tr>
            <th scope="col">Repository</th>
            <th scope="col">Description</th>
            <th scope="col">Owner</th>
            <th scope="col">Language</th>
            <th scope="col">Status</th>
            <th scope="col">Stars</th>
            <th scope="col">Updated</th>
          </tr>
        </thead>
        <tbody>
          {repositoryIndex.map(({ data }) => {
            const statuses = [
              data.featured ? 'Selected' : null,
              data.archived ? 'Archived' : null,
              data.fork ? 'Fork' : null,
              data.template ? 'Template' : null,
            ].filter(Boolean);

            return (
              <tr>
                <th scope="row">
                  <a href={data.url} target="_blank" rel="noreferrer">{data.title}</a>
                </th>
                <td>{data.description ?? 'No description on GitHub.'}</td>
                <td>{data.owner}</td>
                <td>{data.language ?? 'Unspecified'}</td>
                <td>{statuses.length > 0 ? statuses.join(', ') : 'Active'}</td>
                <td>{data.stars}</td>
                <td>
                  <time datetime={data.updatedAt}>{formatRepositoryDate(data.updatedAt)}</time>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </section>
  </main>

  <footer>
    <p>Jonathan Youngblood, {new Date().getFullYear()}</p>
    <p>Repository data provided by GitHub.</p>
  </footer>
</RepositoryLayout>

