        <section
          id="repository-index"
          aria-labelledby="repository-index-heading"
        >
          <table width="100%" cellpadding="8" rules="rows" frame="below">
            <colgroup>
              <col span="3" />
              <col span="6" width="10%" />
            </colgroup>
            <thead>
              <tr>
                <th scope="col" aria-label="Favorite"></th>
                <th scope="col" align="left"></th>
                <th scope="col"></th>
                <th scope="col" align="center">Language</th>
                <th scope="col" align="center">Release</th>
                <th scope="col" align="center">Commits</th>
                <th scope="col" align="center">Type</th>
                <th scope="col" align="center">Created</th>
                <th scope="col" align="center">Updated</th>
              </tr>
            </thead>
            <tbody>
              {
                repositoryIndex.map(({ data }) => {
                  const isFavorite =
                    repositoryNameIndex(data, featuredNames) >= 0;

                  return (
                    <tr class={isFavorite ? "featured" : undefined}>
                      <td aria-label={isFavorite ? "Favorite" : undefined}>
                        {isFavorite ? "★" : ""}
                      </td>
                      <th scope="row" align="left">
                        <a href={data.url} target="_blank" rel="noopener">
                          {formatRepositoryName(data)}
                        </a>
                      </th>
                      <td>{data.description ?? ""}</td>
                      <td align="center">{data.language ?? ""}</td>
                      <td align="center">
                        {formatRelease(data.latestRelease)}
                      </td>
                      <td align="center">{data.commitCount ?? ""}</td>
                      <td align="center">
                        {formatRepositoryTypes(data.topics)}
                      </td>
                      <td align="center">
                        <time datetime={data.createdAt}>
                          {formatRepositoryYear(data.createdAt)}
                        </time>
                      </td>
                      <td align="center">
                        <time datetime={data.updatedAt}>
                          {formatRepositoryDate(data.updatedAt)}
                        </time>
                      </td>
                    </tr>
                  );
                })
              }
            </tbody>
          </table>
