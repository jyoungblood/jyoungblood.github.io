---
import { getCollection } from "astro:content";

// A short name matches any fetched owner. Use `owner/name` to disambiguate.
// Featured projects are displayed in the order listed here.
const featuredRepositoryNames = [
  "vergekit",
  "arena-screensaver",
  "pocketdocs",
  // "darkwave",
  "jquery-digital-sign",
  "smoke.js",
  // "stereo",
];

const hiddenRepositoryNames: string[] = [".github"];

const repositories = await getCollection("repositories");

const normalizeRepositoryName = (name: string) =>
  name.trim().toLocaleLowerCase();
const featuredNames = featuredRepositoryNames.map(normalizeRepositoryName);
const hiddenNames = hiddenRepositoryNames.map(normalizeRepositoryName);

const repositoryNameIndex = (
  repository: (typeof repositories)[number]["data"],
  names: string[],
) => {
  const fullNameIndex = names.indexOf(
    normalizeRepositoryName(repository.fullName),
  );
  return fullNameIndex >= 0
    ? fullNameIndex
    : names.indexOf(normalizeRepositoryName(repository.name));
};

const featuredRepositories = repositories
  .filter(({ data }) => repositoryNameIndex(data, featuredNames) >= 0)
  .sort(
    (a, b) =>
      repositoryNameIndex(a.data, featuredNames) -
      repositoryNameIndex(b.data, featuredNames),
  );

const repositoryIndex = repositories
  .filter(({ data }) => repositoryNameIndex(data, hiddenNames) < 0)
  .sort((a, b) => Date.parse(b.data.createdAt) - Date.parse(a.data.createdAt));

const formatRepositoryDate = (date: string) =>
  new Intl.DateTimeFormat("en-US", {
    month: "short",
    year: "numeric",
  }).format(new Date(date));

const formatRepositoryYear = (date: string) =>
  new Intl.DateTimeFormat("en-US", { year: "numeric" }).format(new Date(date));

const formatRelease = (release: string | null) =>
  release?.replace(/^v/i, "") ?? "";

const formatRepositoryName = (
  repository: (typeof repositories)[number]["data"],
) =>
  repository.ownerType === "Organization"
    ? repository.fullName
    : repository.name;

const formatRepositoryTypes = (topics: string[]) =>
  topics
    .filter((topic) => topic.startsWith("type-"))
    .map((topic) => topic.slice("type-".length).replaceAll("-", " "))
    .join(", ");

const formatRomanNumeral = (value: number) => {
  const numerals: Array<[number, string]> = [
    [1000, "M"],
    [900, "CM"],
    [500, "D"],
    [400, "CD"],
    [100, "C"],
    [90, "XC"],
    [50, "L"],
    [40, "XL"],
    [10, "X"],
    [9, "IX"],
    [5, "V"],
    [4, "IV"],
    [1, "I"],
  ];
  let remainder = value;
  let result = "";

  for (const [number, numeral] of numerals) {
    while (remainder >= number) {
      result += numeral;
      remainder -= number;
    }
  }

  return result;
};
