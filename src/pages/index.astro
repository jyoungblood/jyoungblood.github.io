      <section id="repository-index" aria-labelledby="repository-index-heading">
        <table>
          <thead>
            <tr>
              <th scope="col" aria-label="Favorite"></th>
              <th scope="col" align="left"></th>
              <th scope="col"></th>
              <th scope="col">Language</th>
              <th scope="col">Created</th>
              <th scope="col">Updated</th>
            </tr>
          </thead>
          <tbody>
            {
              repositoryIndex.map(({ data }) => {
                const isFavorite =
                  repositoryNameIndex(data, featuredNames) >= 0;

                return (
                  <tr>
                    <td aria-label={isFavorite ? "Favorite" : undefined}>
                      {isFavorite ? "★" : ""}
                    </td>
                    <th scope="row" align="left">
                      <a href={data.url} target="_blank" rel="noopener">
                        {data.title}
                      </a>
                    </th>
                    <td>{data.description ?? ""}</td>
                    <td>{data.language ?? ""}</td>
                    <td>
                      <time datetime={data.createdAt}>
                        {formatRepositoryDate(data.createdAt)}
                      </time>
                    </td>
                    <td>
                      <time datetime={data.updatedAt}>
                        {formatRepositoryDate(data.updatedAt)}
                      </time>
                    </td>
                  </tr>
                );
              })
            }
          </tbody>
        </table>
      </section>
    </main>

    <footer>
      &copy; {new Date().getFullYear()} &nbsp;
      <a href="https://jonathanyoungblood.com">Jonathan Youngblood</a>. All
      rights reserved.
    </footer>
  </center>
</RepositoryLayout>
